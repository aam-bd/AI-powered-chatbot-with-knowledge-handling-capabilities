# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and populate with your environment secrets and settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & Infrastructure
# ------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
JWT_SECRET_KEY=change-me-to-a-secure-random-secret-key-at-least-32-chars
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=["http://localhost:3000"]

# Database & Cache URLs
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/chatbot
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# Initial Admin Seeding (optional: seeds admin user if set at startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=adminsecurepassword123

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# Choose one of the provider presets below or configure custom endpoints.
# ------------------------------------------------------------------------------

# --- Preset 1: OpenAI (Default) ---
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=   #Google AI Studio Free Tier
FAST_MODEL=gemini-3.8-flash
ANSWER_MODEL=

# --- Preset 2: OpenRouter ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your_openrouter_api_key_here
# FAST_MODEL=google/gemini-2.0-flash-001
# ANSWER_MODEL=anthropic/claude-3.5-sonnet

# --- Preset 3: Google Gemini (OpenAI-compatible endpoint) ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your_gemini_api_key_here
# FAST_MODEL=gemini-2.0-flash
# ANSWER_MODEL=gemini-2.0-flash

# --- Preset 4: Anthropic (Native Messages API) ---
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://api.anthropic.com
# LLM_API_KEY=your_anthropic_api_key_here
# FAST_MODEL=claude-3-5-haiku-20241022
# ANSWER_MODEL=claude-3-5-sonnet-20241022

# Optional per-role overrides (leave unset to inherit shared LLM_* settings)
# FAST_LLM_PROVIDER=
# FAST_LLM_BASE_URL=
# FAST_LLM_API_KEY=
# ANSWER_LLM_PROVIDER=
# ANSWER_LLM_BASE_URL=
# ANSWER_LLM_API_KEY=

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# Embeddings & Vector Search Settings
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=local
# For openai_compatible embedding endpoints:
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ------------------------------------------------------------------------------
# Ingestion, Chunking & Retrieval Parameters
# ------------------------------------------------------------------------------
CHUNK_SIZE_TOKENS=650
CHUNK_OVERLAP_TOKENS=80
RETRIEVAL_TOP_K=15
RERANK_TOP_N=4
RERANK_THRESHOLD=0.5
MAX_UPLOAD_MB=20
ALLOWED_URL_DOMAINS=[]
ENABLE_OCR=false
RECONCILE_STALE_MINUTES=15

# ------------------------------------------------------------------------------
# Chat Session & Fallback Messaging
# ------------------------------------------------------------------------------
HISTORY_MESSAGES=6
SESSION_TTL_HOURS=24
FALLBACK_MESSAGE=I'm sorry, I couldn't find information about that in my knowledge base.
GREETING_MESSAGE=Hi! I can answer questions about the knowledge base. What would you like to know?
